@model casaDoBolo.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<style>

        @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap');

        :root {
                --primary-color: #800000; /* Vinho principal */
                --salmon-hover: #E5A172; /* Salmão claro para hover */
                --background-color: #f5f0e6; /* Cor de fundo creme */
                --card-bg: #ffffff;
                --text-color: #4a4a4a;
                --border-color: #e0e0e0;

    }

        body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--background-color);
                color: var(--text-color);
                margin: 0;
                padding-top: 50px; 

    }

        @@keyframes fadeIn {
                from

    {
                    opacity: 0;
                    transform: translateY(-20px);

    }

            to {
                    opacity: 1;
                    transform: translateY(0);

    }


    }


    
        .center-wrapper {
                display: flex;
                justify-content: center;
                margin-top: 50px;
                margin-bottom: 50px;
                padding: 0 20px;
                animation: fadeIn 1s ease-out;

    }


        .card-custom {
                max-width: 650px;
                width: 100%;
                background-color: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);

    }

        .card-header-custom {
                background-color: var(--primary-color);
                color: #fff;
                padding: 25px;
                text-align: center;
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;
                font-family: 'Playfair Display', serif;

    }

            .card-header-custom h2 {
                    margin: 0;
                    font-weight: 700;
                    font-size: 2rem;
                    text-transform: uppercase;

    }


   
        .card-body-custom {
                padding: 30px;

    }


        dl {
                margin-bottom: 20px;

    }

        dt {
                font-weight: 700; /* Mais destaque */
                color: var(--primary-color);
                margin-bottom: 5px;
                font-size: 1.05rem;

    }

        dd {
                margin-bottom: 20px;
                color: var(--text-color);
                border-bottom: 1px dashed var(--border-color);
                padding-bottom: 10px;
                padding-left: 10px;

    }


        dl > div:last-child dd {
                border-bottom: none;
                margin-bottom: 5px;
                padding-bottom: 0;

    }


        .btn-group {
                display: flex;
                justify-content: space-between;
                margin-top: 20px;

    }

        .btn-action {
                background-color: var(--primary-color);
                color: #fff;
                padding: 10px 25px;
                text-decoration: none;
                font-weight: 600;
                border-radius: 6px;
                transition: all 0.3s ease;
                text-transform: uppercase;
                letter-spacing: 1px;
                border: none;

    }

                .btn-action:hover {
                        background-color: #660000;
                        color: var(--salmon-hover);
                        transform: translateY(-2px);
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);

        }

        .btn-back {
                background-color: transparent;
                color: var(--primary-color);
                padding: 10px 25px;
                font-weight: 600;
                border: 2px solid var(--primary-color);
                border-radius: 6px;
                text-decoration: none;
                transition: all 0.3s ease;
                text-transform: uppercase;

    }

                .btn-back:hover {
                        background-color: var(--primary-color);
                        color: var(--card-bg);
                        transform: translateY(-2px);
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);

        }


        @@media (max-width: 576px) {
                .btn-group

    {
                    flex-direction: column;
                    gap: 15px;

    }

            .btn-action, .btn-back {
                    text-align: center;

    }

            .card-header-custom h2 {
                    font-size: 1.5rem;

    }


    }
</style>

<div class="center-wrapper">
    <div class="card card-custom border-0">

        <div class="card-header-custom">
            <h2>Detalhes do Cliente</h2>
        </div>

        <div class="card-body-custom">
            <dl>
                <div class="row">
                    <dt class="col-sm-4">Nome:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>
                </div>

                <div class="row">
                    <dt class="col-sm-4">CPF:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.CPF)</dd>
                </div>

                <div class="row">
                    <dt class="col-sm-4">Telefone:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Telefone)</dd>
                </div>

                <div class="row">
                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>
                </div>

                <div class="row">
                    <dt class="col-sm-4">Endereço:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Endereco)</dd>
                </div>
            </dl>

            <div class="btn-group">
                <a asp-action="Index" class="btn-back">Voltar para a lista</a>
                <a asp-action="Edit" asp-route-id="@Model?.ClienteID" class="btn-action">Editar Cliente</a>
            </div>
        </div>
    </div>
</div>
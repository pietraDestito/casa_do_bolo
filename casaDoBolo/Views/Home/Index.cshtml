@{
    ViewData["Title"] = "Loja de Bolos da Rosely Destito";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>

    /* Estilos Globais */
        :root {
                --primary-color: #8B0000; /* Vinho */
                --secondary-color: #D2B48C; /* Caramelo */
                --dark-text-color: #333333;
                --light-bg-color: #FCF5EC;

    }

        body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--light-bg-color);
                color: var(--dark-text-color);
                overflow-x: hidden;

    }


    /* Hero Banner */
        .hero-banner {
                width: 100%;
                height: auto;
                display: block;

    }

                .hero-banner img {
                        width: 100%;
                        height: auto;
                        display: block;

        }


    /* Seção Sobre Nós */
        .about-section {
                padding: 80px 0;

    }

        .section-title {
                font-family: 'Poppins', sans-serif;
                font-weight: 700;
                font-size: 2.5rem;
                color: var(--primary-color);
                text-align: center;
                margin-bottom: 60px;
                position: relative;

    }

            .section-title::after {
                    content: '';
                    width: 60px;
                    height: 3px;
                    background-color: var(--secondary-color);
                    position: absolute;
                    bottom: -15px;
                    left: 50%;
                    transform: translateX(-50%);

    }

        .about-text {
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: center;

    }

            .about-text p {
                    font-size: 1.1rem;
                    line-height: 1.8;

    }

            .about-text h3 {
                    font-weight: 600;
                    font-size: 1.5rem;
                    color: var(--primary-color);
                    margin-top: 30px;
                    margin-bottom: 10px;

    }

            .about-text strong {
                    font-weight: 700;
                    color: var(--primary-color);

    }


    /* Carrossel - AJUSTE AQUI */
        .carousel-container {
                border-radius: 10px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(0,0,0,0.1);
                height: 100%;
        /* NOVO: Limita a largura do contêiner da imagem */
        max-width: 450px;
        margin: 0 auto; /* Centraliza o contêiner dentro da coluna */

    }

        .carousel-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;

    }


    /* Seção Por que nos escolher */
        .why-choose-section {
                padding: 50px 0;

    }

                .why-choose-section .container {
                        max-width: 1100px; /* Aumenta a largura para os itens ficarem lado a lado */
                        text-align: center; /* Centraliza o título */

        }

        .why-choose-grid {
                display: flex;
                flex-wrap: wrap; /* Permite que os itens quebrem linha */
                justify-content: center;
                gap: 30px; /* Espaçamento entre os itens */
                margin-top: 40px;

    }

        .why-choose-item {
                flex: 1 1 300px; /* Permite que os itens cresçam/encolham, com base de 300px */
                max-width: 350px; /* Limita a largura máxima do item */
                background-color: #fff;
                padding: 30px;
                border-radius: 10px;
                box-shadow: 0 6px 20px rgba(0,0,0,0.08);
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                text-align: center;

    }

            .why-choose-item:hover {
                    transform: translateY(-8px);
                    box-shadow: 0 10px 30px rgba(0,0,0,0.12);

    }

            .why-choose-item .fas {
                    color: var(--secondary-color);
                    font-size: 3rem; /* Ícone maior */
                    margin-bottom: 20px;

    }

            .why-choose-item span {
                    display: block;
                    font-size: 1.1rem;
                    font-weight: 500;
                    color: var(--dark-text-color);
                    line-height: 1.6;

    }


    /* Seção FAQ */
        .faq-section-wrapper {
                padding: 50px 0;
                background-color: #f6efe0; /* Fundo bege */
                margin: 50px auto;
                max-width: 900px; /* Largura reduzida */
                border-radius: 10px; /* Bordas arredondadas */

    }

                .faq-section-wrapper .container {
                        padding: 0 20px;

        }

        .faq-section {
                background-color: transparent; /* O fundo é aplicado no wrapper, não aqui */
                padding: 0; /* Remove o padding do container interno */

    }

        .faq-item {
                margin-bottom: 20px;
                border: 1px solid #e0d9cc;
                border-radius: 8px;
                box-shadow: 0 4px 10px rgba(0,0,0,0.05);
                transition: box-shadow 0.3s ease;

    }

            .faq-item:hover {
                    box-shadow: 0 6px 15px rgba(0,0,0,0.1);

    }

        .faq-question {
                background-color: #fff;
                border-radius: 8px;
                padding: 15px 20px;
                cursor: pointer;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-weight: 600;
                color: var(--primary-color);
                transition: background-color 0.3s ease, border-radius 0.3s ease;

    }

            .faq-question:hover {
                    background-color: #f8f8f8;

    }

            .faq-question.active {
                    border-radius: 8px 8px 0 0;

    }

            .faq-question .fas {
                    transition: transform 0.3s ease;

    }

        .faq-answer {
                background-color: #fcfcf4;
                border-top: 1px solid #e0d9cc;
                border-radius: 0 0 8px 8px;
                padding: 0 20px;
                margin-top: -1px;
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.5s ease-in-out, padding 0.5s ease-in-out;

    }


    /* Estilo para o texto de resposta */
            .faq-answer p {
                    padding: 15px 0;
                    margin-bottom: 0;
                    font-size: 1rem;
                    line-height: 1.6;
                    color: #555; /* Cor mais suave para o texto de resposta */

    }

            .faq-answer.show {
                    max-height: 200px;
                    padding: 15px 20px;

    }


    /* Responsividade */
        @@media (max-width: 991.98px) {
                .about-text

    {
                    padding-right: 15px;
                    margin-bottom: 40px;

    }

            .faq-section-wrapper {
                    max-width: 90%;

    }

            .why-choose-grid {
                    flex-direction: column; /* Empilha os itens em telas menores */
                    align-items: center;

    }

            .why-choose-item {
                    max-width: 90%; /* Ajusta a largura do item em telas menores */

    }


    }
</style>

<div class="hero-banner">
    <img src="~/img/banner.jpg" alt="Loja de Bolos Rosely Destito" />
</div>

<div class="container about-section">
    <h2 class="section-title">Sobre Nós:</h2>
    <div class="row align-items-center justify-content-center g-5">
        <div class="col-lg-6 d-flex align-self-start">
            <div class="about-text">
                <p>
                    A <strong>Casa do Bolo</strong> nasceu do amor pela arte de adoçar vidas. Há mais de <strong>15 anos</strong>, combinamos receitas consagradas com um toque de inovação para criar momentos inesquecíveis.
                </p>
                <h3>Nossa Missão</h3>
                <p>
                    Levar alegria e <strong>boas lembranças</strong> para a mesa de cada cliente com bolos preparados com carinho e dedicação. Nosso compromisso é transformar cada fatia em uma celebração.
                </p>
            </div>
        </div>
        <div class="col-lg-6 d-flex align-self-start justify-content-center">
            <div class="carousel-container w-100">
                <div id="carouselExampleIndicators" class="carousel slide h-100" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner h-100">
                        <div class="carousel-item active h-100">
                            <img src="~/img/png1.png" class="d-block w-100" alt="Bolo de Família">
                        </div>
                        <div class="carousel-item h-100">
                            <img src="~/img/png2.png" class="d-block w-100" alt="Foto 2">
                        </div>
                        <div class="carousel-item h-100">
                            <img src="~/img/png3.png" class="d-block w-100" alt="Foto 3">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container why-choose-section">
    <h2 class="section-title">Por que escolher a Casa do Bolo?</h2>
    <div class="why-choose-grid">
        <div class="why-choose-item">
            <i class="fas fa-certificate"></i>

            <span>Feito com ingredientes frescos e selecionados, garantindo sabor puro.</span>
        </div>
        <div class="why-choose-item">
            <i class="fas fa-heart"></i>

            <span>Receitas de família, com o autêntico sabor de bolo caseiro que remete à infância.</span>
        </div>
        <div class="why-choose-item">
            <i class="fas fa-hand-holding-heart"></i>

            <span>Produção artesanal com atenção meticulosa a cada detalhe.</span>
        </div>
    </div>
</div>

<div class="faq-section-wrapper">
    <div class="container faq-section">
        <h2 class="section-title">Dúvidas Frequentes</h2>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleAnswer(this)">
                        Qual o prazo de antecedência para um pedido ser aceito?
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        <p>Para garantir a qualidade e frescor de nossos bolos, os pedidos devem ser feitos com no mínimo <strong>48 horas de antecedência</strong>.</p>
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleAnswer(this)">
                        Até quando posso alterar um pedido já feito?
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        <p>Alterações no sabor, tamanho ou decoração do bolo podem ser solicitadas com até <strong>48 horas de antecedência</strong> da data de retirada, sujeito à nossa confirmação.</p>
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleAnswer(this)">
                        Como o pedido é retirado?
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        <p>Os pedidos devem ser <strong>retirados na loja</strong>, mediante horário agendado no momento da finalização da compra. Não fazemos entregas.</p>
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleAnswer(this)">
                        Qual o horário de funcionamento da loja?
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        <p>Nosso horário de funcionamento é de <strong>segunda a sexta</strong>, das <strong>8h às 18h</strong>, e aos <strong>sábados e domingos</strong>, das <strong>8h às 12h</strong>.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleAnswer(element) {
        const item = element.parentElement;
        const answer = element.nextElementSibling;
        const icon = element.querySelector('.fas');

        // Close all other open answers
        document.querySelectorAll('.faq-item').forEach(otherItem => {
            if (otherItem !== item) {
                const otherAnswer = otherItem.querySelector('.faq-answer');
                const otherQuestion = otherItem.querySelector('.faq-question');
                const otherIcon = otherItem.querySelector('.fas');

                if (otherAnswer.classList.contains('show')) {
                    otherAnswer.classList.remove('show');
                    otherQuestion.classList.remove('active');
                    otherIcon.style.transform = 'rotate(0deg)';
                }
            }
        });

        // Toggle the clicked answer
        answer.classList.toggle('show');
        element.classList.toggle('active');

        if (answer.classList.contains('show')) {
            icon.style.transform = 'rotate(180deg)';
        } else {
            icon.style.transform = 'rotate(0deg)';
        }
    }
</script>
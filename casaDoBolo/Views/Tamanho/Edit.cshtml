@model casaDoBolo.Models.Tamanho

@{
    ViewData["Title"] = "Editar Tamanho";
}

<style>
    

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap');

    :root {
        --primary-color: #800000; /* Vinho principal */
        --salmon-hover: #E5A172; /* Cor salmão/terracota para o hover */
        --background-color: #f5f0e6; /* Fundo bege suave */
        --text-color: #4a4a4a; /* Cor padrão do texto */
        --border-color: #e0e0e0; /* Cinza da borda */
        --danger-color: #dc3545; /* Vermelho para erros */
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--background-color);
        color: var(--text-color);
        min-height: 100vh;
        
        margin: 0;
        padding-top: 20px; 
    }

    .form-container {
        padding: 40px;
        background-color: #ffffff; 
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        border-top: 5px solid var(--primary-color);
        max-width: 600px;
        width: 100%;

        margin: 60px auto 40px auto;
    }
    .form-container h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            color: var(--primary-color);
            font-weight: 700;
            margin-bottom: 10px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .form-container h4 {
            color: var(--text-color);
            font-weight: 400;
            text-align: center;
            margin-bottom: 30px;
        }

    .form-group label, .control-label {
        color: var(--text-color);
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid var(--border-color);
        padding: 12px;
        transition: border-color 0.3s, box-shadow 0.3s;
        color: var(--text-color);
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(128, 0, 0, 0.25);
        }

    .text-danger {
        font-size: 0.85em;
        color: var(--danger-color);
        font-weight: 500;
    }

    
    .btn-custom {
        background-color: var(--primary-color);
        color: white;
        font-weight: 600;
        padding: 12px 25px;
        border-radius: 6px;
        text-decoration: none;
        transition: color 0.3s, transform 0.2s, background-color 0.3s;
        font-size: 1rem;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        text-transform: uppercase;
        border: none;
    }

        .btn-custom:hover {
            background-color: #660000;
            color: var(--salmon-hover);
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-secondary-custom {
        background-color: #f5f5f5;
        color: #666;
        border: 1px solid #ddd;
        padding: 12px 25px;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.3s, color 0.3s;
        font-size: 1rem;
        text-transform: uppercase;
    }

        .btn-secondary-custom:hover {
            background-color: #e0e0e0;
            color: #333;
            text-decoration: none;
        }

    .justify-content-center {
    }
</style>

<div class="row">
    <div class="col-md-7 mx-auto">
        <div class="form-container">
            <h1>@ViewData["Title"]</h1>
            <h4>Tamanho</h4>
            <hr />
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="TamanhoID" />

                <div class="form-group mb-4">
                    <label asp-for="Fatias" class="control-label">Fatias</label>
                    <input asp-for="Fatias" class="form-control" />
                    <span asp-validation-for="Fatias" class="text-danger"></span>
                </div>

                <div class="form-group mb-5">
                    <label asp-for="Valor" class="control-label">Valor (R$)</label>
                    <input asp-for="Valor" class="form-control" />
                    <span asp-validation-for="Valor" class="text-danger"></span>
                </div>

                <div class="form-group mt-4 d-flex justify-content-between">
                    <a asp-action="Index" class="btn-secondary-custom">Voltar para a Lista</a>
                    <input type="submit" value="Salvar Alterações" class="btn-custom" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
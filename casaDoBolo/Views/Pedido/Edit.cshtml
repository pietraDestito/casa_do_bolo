@model casaDoBolo.Models.Pedido

@{
    ViewData["Title"] = "Editar Pedido";

    var formasPagamento = new List<string>
    {
        "Cartao de Credito",
        "Cartao de Debito",
        "Pix",
        "Dinheiro Fisico"
    };

    
    var limiteAlerta = Model.DataRetirada.AddHours(-48);
    var precisaAlerta = DateTime.Now > limiteAlerta;

    var alertaInicial = precisaAlerta ? "true" : "false";

    var dataRetiradaOriginal = Model.DataRetirada.ToString("yyyy-MM-ddTHH:mm");
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap');

    :root {
        --primary-color: #800000; 
        --salmon-hover: #E5A172; 
        --background-color: #f5f0e6; 
        --text-color: #4a4a4a; 
        --border-color: #e0e0e0; 
        --danger-color: #dc3545; 
        --warning-color: #ffc107; 
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--background-color);
        color: var(--text-color);
    }

    .form-container {
        padding: 40px;
        background-color: #ffffff; 
        border-radius: 12px; 
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        margin-top: 40px;
        border-top: 5px solid var(--primary-color); 
    }

        .form-container h1 {
            font-family: 'Playfair Display', serif; /* Fonte Clássica */
            font-size: 2.5rem;
            color: var(--primary-color);
            font-weight: 700;
            margin-bottom: 10px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .form-container h4 {
            color: var(--text-color);
            font-weight: 400;
            text-align: center;
            margin-bottom: 30px;
        }

    .form-group label {
        color: var(--text-color);
        font-weight: 600; 
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid var(--border-color);
        padding: 12px;
        transition: border-color 0.3s, box-shadow 0.3s;
        color: var(--text-color);
    }

        .form-control:focus {
            border-color: var(--primary-color); 
            box-shadow: 0 0 0 0.25rem rgba(128, 0, 0, 0.25);
        }

        .form-control[type="datetime-local"] {
            height: calc(2.5rem + 2px);
            padding: 0.375rem 0.75rem;
        }

    .btn-custom { 
        background-color: var(--primary-color);
        color: white;
        font-weight: 600;
        padding: 12px 25px;
        border-radius: 6px;
        text-decoration: none;
        transition: color 0.3s, transform 0.2s, background-color 0.3s;
        font-size: 1rem;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        text-transform: uppercase;
        border: none;
    }

        .btn-custom:hover {
            background-color: #660000; 
            color: var(--salmon-hover);
            transform: translateY(-2px);
        }

    .btn-secondary-custom {
        background-color: #f5f5f5;
        color: #666;
        border: 1px solid #ddd;
        padding: 12px 25px;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.3s, color 0.3s;
        font-size: 1rem;
    }

        .btn-secondary-custom:hover {
            background-color: #e0e0e0;
            color: #333;
            text-decoration: none; 
        }

    .text-danger {
        font-size: 0.85em;
        color: var(--danger-color);
        font-weight: 500;
    }

    .alert-48h {
        padding: 15px;
        margin-top: 15px;
        border-radius: 6px;
        background-color: #fff3cd; 
        color: #856404; 
        border: 1px solid #ffeeba;
        font-weight: 500;
        display: none; 
    }

        .alert-48h i {
            margin-right: 8px;
            color: var(--warning-color);
        }
</style>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-container">
            <h1>@ViewData["Title"]</h1>
            <h4>Atualize as informações do pedido</h4>
            <hr />
            <form id="editForm" asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="PedidoID" />

                <div class="form-group mb-4">
                    <label asp-for="DataRetirada" class="control-label">Data de Retirada</label>
                    <input id="DataRetirada" asp-for="DataRetirada" class="form-control" type="datetime-local" />
                    <span asp-validation-for="DataRetirada" class="text-danger"></span>

                    <div id="alerta48h" class="alert-48h">
                        <i class="fas fa-exclamation-triangle"></i>
                        <b>Atenção:</b> A data de retirada está com menos de <b>48 horas</b> de antecedência. Isso pode impactar a produção.
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="FormaPagamento" class="control-label">Forma de Pagamento</label>
                    <select asp-for="FormaPagamento" class="form-control">

                        @if (string.IsNullOrEmpty(Model.FormaPagamento))
                        {
                            <option value="" selected disabled>Selecione a Forma de Pagamento</option>
                        }

                        @foreach (var forma in formasPagamento)
                        {
                            <option value="@forma"
                                    selected="@(Model.FormaPagamento == forma ? "selected" : null)">

                                @(forma == "Cartao de Credito" ? "Cartão de Crédito" :
                                    forma == "Cartao de Debito" ? "Cartão de Débito" :
                                    forma == "Dinheiro Fisico" ? "Dinheiro Físico" : forma)
                            </option>
                        }
                    </select>
                    <span asp-validation-for="FormaPagamento" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="fk_ClienteID" class="control-label">Cliente</label>
                    <select asp-for="fk_ClienteID" class="form-control" asp-items="ViewBag.Clientes"></select>
                    <span asp-validation-for="fk_ClienteID" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="fk_SaborID" class="control-label">Sabor do Bolo</label>
                    <select asp-for="fk_SaborID" class="form-control" asp-items="ViewBag.Sabores"></select>
                    <span asp-validation-for="fk_SaborID" class="text-danger"></span>
                </div>

                <div class="form-group mb-5">
                    <label asp-for="fk_TamanhoID" class="control-label">Tamanho do Bolo</label>
                    <select asp-for="fk_TamanhoID" class="form-control" asp-items="ViewBag.Tamanhos"></select>
                    <span asp-validation-for="fk_TamanhoID" class="text-danger"></span>
                </div>

                <div class="form-group mt-4 d-flex justify-content-between">
                    <a asp-action="Index" class="btn-secondary-custom">Voltar para a Lista</a>
                    <input type="submit" id="submitButton" value="Salvar Alterações" class="btn-custom" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const editForm = document.getElementById('editForm');
        const dataRetiradaInput = document.getElementById('DataRetirada');
        const submitButton = document.getElementById('submitButton');
        const alerta48h = document.getElementById('alerta48h');

        const precisaAlertaInicial = @alertaInicial;

        let isConfirmed = false;

        function calcularDiferencaHoras(dataFutura, dataAtual) {
            const diffMs = dataFutura.getTime() - dataAtual.getTime();
            return diffMs / (1000 * 60 * 60); 
        }

        function verificarAlerta() {
            const novaDataStr = dataRetiradaInput.value;
            if (!novaDataStr) {
                alerta48h.style.display = 'none';
                return false;
            }

            const novaData = new Date(novaDataStr);
            const dataAtual = new Date();

            const horasRestantes = calcularDiferencaHoras(novaData, dataAtual);

            if (horasRestantes < 48 && horasRestantes > 0) {
                alerta48h.style.display = 'block';
                return true;
            } else {
                alerta48h.style.display = 'none';
                return false;
            }
        }

        dataRetiradaInput.addEventListener('change', verificarAlerta);


        editForm.addEventListener('submit', function (e) {

            if (isConfirmed) {
                return true;
            }

            e.preventDefault(); 

            if (verificarAlerta()) {

                Swal.fire({
                    title: 'Confirmação de Alteração Urgente!',
                    html: `
                                <div style="text-align: left;">
                                    <p>Você está alterando este pedido para a data de retirada com menos de <b>48 horas</b> de antecedência.</p>
                                    <p><strong>Isso pode causar problemas operacionais.</strong></p>
                                    <p>Tem certeza que deseja <b>salvar esta alteração</b>?</p>
                                </div>
                            `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--danger-color)', 
                    cancelButtonColor: 'var(--primary-color)',
                    confirmButtonText: 'Sim, Salvar Assim Mesmo',
                    cancelButtonText: 'Cancelar Edição'
                }).then((result) => {
                    if (result.isConfirmed) {
                        isConfirmed = true;
                        submitButton.click(); 
                    }
                });
            } else {
                isConfirmed = true;
                editForm.submit();
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            if (precisaAlertaInicial) {
                alerta48h.style.display = 'block';
            }
            dataRetiradaInput.addEventListener('change', verificarAlerta);
        });

    </script>
}
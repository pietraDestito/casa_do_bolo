@model casaDoBolo.Models.Sabor

@{
    ViewData["Title"] = "Detalhes do Sabor";
}

<style>
  
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap');

    :root {
        --primary-color: #800000; /* Vinho principal */
        --salmon-hover: #E5A172; /* Salmão claro para hover */
        --background-color: #f5f0e6; /* Cor de fundo creme */
        --card-bg: #ffffff;
        --text-color: #4a4a4a;
        --text-detail: #2c2c2c; /* Cor escura para o valor do detalhe */
        --border-color: #e0e0e0;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--background-color);
        color: var(--text-color);
        margin: 0;
        padding-top: 50px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

   

    .center-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 50px;
        margin-bottom: 50px;
        padding: 0 20px;
        animation: fadeIn 1s ease-out;
    }

    .card-custom {
        max-width: 650px;
        width: 100%;
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    .card-header-custom {
        background-color: var(--primary-color);
        color: #fff;
        padding: 25px;
        text-align: center;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        font-family: 'Playfair Display', serif;
    }

        .card-header-custom h2 {
            margin: 0;
            font-weight: 700;
            font-size: 2rem;
            text-transform: uppercase;
        }



    .card-body-custom {
        padding: 30px;
    }

    .dl-label {
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 5px;
        font-size: 1.05rem;
        padding-top: 5px;
        padding-bottom: 0px;
        margin-bottom: 10px;
    }

    .dl-value {
        margin-bottom: 20px;
        color: var(--text-detail);
        font-weight: 500;
        border-bottom: none;
        padding-bottom: 10px;
        padding-left: 10px;
        padding-top: 5px;
    }

    .dl-list .row:last-child .dl-value {
        border-bottom: none;
        margin-bottom: 5px;
        padding-bottom: 0;
    }

    
    .img-preview {
        max-width: 250px; 
        height: auto;
        border: 3px solid var(--primary-color); 
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        cursor: pointer; 
        transition: transform 0.2s ease-in-out;
    }

        .img-preview:hover {
            transform: scale(1.03); 
        }

    .modal-body-img {
        text-align: center;
    }

        .modal-body-img img {
            max-width: 100%;
            max-height: 90vh; 
            object-fit: contain;
            border-radius: 8px;
        }


    .btn-group {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid var(--border-color);
    }

    .btn-action {
        background-color: var(--primary-color);
        color: #fff;
        padding: 10px 25px;
        text-decoration: none;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
    }

        .btn-action:hover {
            background-color: #660000;
            color: var(--salmon-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

    .btn-back {
        background-color: transparent;
        color: var(--primary-color);
        padding: 10px 25px;
        font-weight: 600;
        border: 2px solid var(--primary-color);
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.3s ease;
        text-transform: uppercase;
    }

        .btn-back:hover {
            background-color: var(--primary-color);
            color: var(--card-bg);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

    @@media (max-width: 576px) {
        .btn-group {
            flex-direction: column;
            gap: 15px;
        }

        .btn-action, .btn-back {
            text-align: center;
        }

        .card-header-custom h2 {
            font-size: 1.5rem;
        }
    }
</style>

<div class="center-wrapper">
    <div class="card card-custom border-0">

        <div class="card-header-custom">
            <h2>@ViewData["Title"]</h2>
        </div>

        <div class="card-body-custom">
            <dl class="dl-list">

                <div class="row">
                    <dt class="col-sm-4 dl-label">@Html.DisplayNameFor(model => model.NomeSabor)</dt>
                    <dd class="col-sm-8 dl-value">@Html.DisplayFor(model => model.NomeSabor)</dd>
                </div>

                <div class="row">
                    <dt class="col-sm-4 dl-label">Foto</dt>
                    <dd class="col-sm-8 dl-value" style="border-bottom: none; margin-bottom: 0;">
                        @if (Model.Foto != null)
                        {
                            <div class="mt-2 mb-3">
                                <img src="data:image/png;base64,@(Convert.ToBase64String(Model.Foto))"
                                     alt="Foto do Sabor"
                                     class="img-preview"
                                     data-bs-toggle="modal"
                                     data-bs-target="#imageModal"
                                     onclick="setImageSource(this.src)" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted" style="margin-top: 5px;">Nenhuma foto cadastrada</p>
                        }
                    </dd>
                </div>
            </dl>

            <div class="btn-group">
                <a asp-action="Index" class="btn-back">Voltar para a Lista</a>
                <a asp-action="Edit" asp-route-id="@Model?.SaborID" class="btn-action">Editar Sabor</a>
            </div>
        </div>
    </div>
</div>




<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Visualização da Foto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body modal-body-img">
                <img id="modalImage" src="" alt="Foto em destaque" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        
        function setImageSource(src) {
            document.getElementById('modalImage').src = src;
        }

    </script>
}
@using Microsoft.AspNetCore.Identity
@model IdentityRole

@{
    ViewData["Title"] = "Criar Nova Função";
}

<style>
    
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap');

    :root {
        --primary-color: #800000; /* Vinho principal */
        --salmon-hover: #E5A172; /* Cor salmão/terracota para o hover */
        --background-color: #f5f0e6; /* Fundo bege suave */
        --text-color: #4a4a4a; /* Cor padrão do texto */
        --border-color: #e0e0e0; /* Cinza da borda */
        --danger-color: #dc3545; /* Vermelho para erros */
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--background-color);
        color: var(--text-color);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center; 
    }
    
    .row.justify-content-center {
        flex-grow: 1;
        align-items: center; 
        padding: 20px 0;
    }

    .form-container {
        padding: 40px;
        background-color: #ffffff; 
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        border-top: 5px solid var(--primary-color); 
        max-width: 600px; 
        width: 100%;
        margin: 0 auto;
    }

        .form-container h2 {
            font-family: 'Playfair Display', serif; /* Fonte Clássica */
            font-size: 2.5rem;
            color: var(--primary-color);
            font-weight: 700;
            margin-bottom: 20px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

    .form-group label, .form-label {
        color: var(--text-color);
        font-weight: 600; 
        margin-bottom: 8px;
        display: block;
    }

    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid var(--border-color);
        padding: 12px;
        transition: border-color 0.3s, box-shadow 0.3s;
        color: var(--text-color);
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color); /* Vinho ao focar no campo */
            box-shadow: 0 0 0 0.25rem rgba(128, 0, 0, 0.25);
        }

   
    .btn-custom {
        background-color: var(--primary-color);
        color: white;
        font-weight: 600;
        padding: 12px 25px;
        border-radius: 6px;
        text-decoration: none;
        transition: color 0.3s, transform 0.2s, background-color 0.3s;
        font-size: 1rem;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        text-transform: uppercase;
        border: none;
        cursor: pointer;
    }

        .btn-custom:hover {
            background-color: #660000; /* Vinho mais escuro no hover */
            color: var(--salmon-hover);
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-secondary-custom {
        background-color: #f5f5f5;
        color: #666;
        border: 1px solid #ddd;
        padding: 12px 25px;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.3s, color 0.3s;
        font-size: 1rem;
        text-transform: uppercase;
        display: inline-block;
    }

        .btn-secondary-custom:hover {
            background-color: #e0e0e0;
            color: #333;
            text-decoration: none;
        }

    .text-danger {
        font-size: 0.85em;
        color: var(--danger-color);
        font-weight: 500;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-container">
            <h2>@ViewData["Title"]</h2>
            <hr />
            <form method="post" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-group mb-5">
                    <label asp-for="Name" class="form-label">Nome da Função</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn-secondary-custom">Voltar para a Lista</a>

                    <button type="submit" class="btn-custom">Salvar Função</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
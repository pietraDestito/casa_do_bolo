@page
@model RegisterModel
@{
    // Mantemos Layout = null para evitar o erro e não carregar a Navbar/Footer
    Layout = null;
    ViewData["Title"] = "Cadastrar Usuário";
}

<style>
    /* -------------------------------------------------------------------------- */
    /* VARIAVEIS E ESTILOS GLOBAIS (Copiados do _Layout.cshtml) */
    /* -------------------------------------------------------------------------- */
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap');

    /* Também adicionamos a fonte do seu layout principal (Roboto) */
    @@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap');

    :root {
        --primary-color: #800000; /* Vinho bordô */
        --salmon-hover: #E5A172;
        --secondary-color: #a0522d; /* Cor secundária do seu layout */
        --accent-color: #ff7f50; /* Cor de destaque do seu layout */
        --background-color: #f5f0e6; /* COR BEGE DE FUNDO */
        --text-color: #4a4a4a;
        --border-color: #e0e0e0;
        --danger-color: #dc3545;
        --input-focus-shadow: rgba(128, 0, 0, 0.25);
    }

    /* Animação 'confetti' copiada do seu layout */
    @@keyframes confetti {
        0% {
            background-position: 0 0;
        }

        100% {
            background-position: 500px 500px;
        }
    }

    /* CORREÇÃO APLICADA AQUI: Define o fundo com o padrão de bolinhas */
    html, body {
        height: 100%;
        margin: 0;
    }

    body {
        font-family: 'Poppins', sans-serif;
        color: var(--text-color);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        /* ESTILOS DE FUNDO COPIADOS DO SEU _Layout.cshtml */
        background-color: var(--background-color);
        background-image: radial-gradient(circle, var(--accent-color) 1px, transparent 1px), radial-gradient(circle, var(--secondary-color) 1px, transparent 1px);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
        animation: confetti 120s linear infinite;
        /* FIM DOS ESTILOS DE FUNDO COPIADOS */
    }

    /* O resto do CSS para o formulário */
    .view-content-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .row.justify-content-center {
        width: 100%;
        max-width: 600px;
        margin: 0;
    }

    .form-container {
        padding: 40px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        border-top: 5px solid var(--primary-color);
        width: 100%;
    }

        .form-container h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--primary-color);
            font-weight: 700;
            margin-bottom: 25px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-container h1 {
            display: none;
        }

    .form-group {
        margin-bottom: 1.5rem;
    }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--text-color);
        }

    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid var(--border-color);
        padding: 14px;
        transition: border-color 0.3s, box-shadow 0.3s;
        color: var(--text-color);
        font-size: 1rem;
        background-color: white;
        height: auto;
    }

        .form-control:focus, .form-select:focus,
        .form-select.input-validation-error:focus, .form-select.is-invalid:focus {
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 0.25rem var(--input-focus-shadow);
        }

    .btn-custom {
        background-color: var(--primary-color);
        color: white;
        font-weight: 600;
        padding: 14px;
        border-radius: 6px;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        width: 100%;
        margin-top: 20px;
        transition: background-color 0.3s, transform 0.2s;
        text-transform: uppercase;
    }

        .btn-custom:hover {
            background-color: #660000;
            color: var(--salmon-hover);
            transform: translateY(-2px);
        }

    .text-danger {
        font-size: 0.85em;
        color: var(--danger-color);
        font-weight: 500;
    }
</style>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seu Aplicativo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>
    <div class="view-content-wrapper">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="form-container">

                    <form id="registerForm" method="post">
                        <h2>Criar Novo Usuário</h2>
                        <hr />
                        @if (!string.IsNullOrEmpty(Model.StatusMessage))
                        {
                            <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
                        }
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        @* Campos Firstname e Lastname *@
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Input.Firstname">Nome</label>
                                    <input asp-for="Input.Firstname" class="form-control" autocomplete="Firstname" aria-required="true" placeholder="Nome" />
                                    <span asp-validation-for="Input.Firstname" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Input.Lastname">Sobrenome</label>
                                    <input asp-for="Input.Lastname" class="form-control" autocomplete="Lastname" aria-required="true" placeholder="Sobrenome" />
                                    <span asp-validation-for="Input.Lastname" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        @* Campo Email *@
                        <div class="form-group">
                            <label asp-for="Input.Email">Email</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        @* Campo Password *@
                        <div class="form-group">
                            <label asp-for="Input.Password">Senha</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Senha" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                            <small class="text-muted">Mínimo de 6 caracteres, com letra maiúscula, minúscula, número e símbolo (ex.: Bolo@123).</small>
                        </div>

                        @* Campo Confirm Password *@
                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword">Confirmar Senha</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirme a senha" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        @* Campo Role (Select) *@
                        <div class="form-group">
                            <label asp-for="Input.Role">Função</label>
                            <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select" aria-required="true">
                                <option disabled selected value="">Selecione a Função (Role)</option>
                            </select>
                            <span asp-validation-for="Input.Role" class="text-danger"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="btn-custom">Cadastrar</button>
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="d-block mt-3">← Voltar ao início</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Scripts necessários para a validação *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

</body>
</html>
@page
@model ForgotPasswordModel
@{
    Layout = null; // não carrega navbar/footer
    ViewData["Title"] = "Esqueci minha senha";
}

<style>
    /* -------------------------------------------------------------------------- */
    /* VARIÁVEIS E ESTILOS GLOBAIS */
    /* -------------------------------------------------------------------------- */
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap');
    @@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap');

    :root {
        --primary-color: #800000; /* Vinho bordô */
        --salmon-hover: #E5A172;
        --secondary-color: #a0522d;
        --accent-color: #ff7f50;
        --background-color: #f5f0e6;
        --text-color: #4a4a4a;
        --border-color: #e0e0e0;
        --danger-color: #dc3545;
        --input-focus-shadow: rgba(128, 0, 0, 0.25);
    }

    @@keyframes confetti {
        0% {
            background-position: 0 0;
        }

        100% {
            background-position: 500px 500px;
        }
    }

    html, body {
        height: 100%;
        margin: 0;
    }

    body {
        font-family: 'Poppins', sans-serif;
        color: var(--text-color);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background-color: var(--background-color);
        background-image: radial-gradient(circle, var(--accent-color) 1px, transparent 1px), radial-gradient(circle, var(--secondary-color) 1px, transparent 1px);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
        animation: confetti 120s linear infinite;
    }

    .view-content-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .row.justify-content-center {
        width: 100%;
        max-width: 600px;
        margin: 0;
    }

    .form-container {
        padding: 40px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        border-top: 5px solid var(--primary-color);
        width: 100%;
    }

        .form-container h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--primary-color);
            font-weight: 700;
            margin-bottom: 25px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .form-control {
        border-radius: 6px;
        border: 1px solid var(--border-color);
        padding: 14px;
        transition: border-color 0.3s, box-shadow 0.3s;
        color: var(--text-color);
        font-size: 1rem;
        background-color: white;
        height: auto;
    }

        .form-control:focus {
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 0.25rem var(--input-focus-shadow);
        }

    .btn-custom {
        background-color: var(--primary-color);
        color: white;
        font-weight: 600;
        padding: 14px;
        border-radius: 6px;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        width: 100%;
        margin-top: 20px;
        transition: background-color 0.3s, transform 0.2s;
        text-transform: uppercase;
    }

        .btn-custom:hover {
            background-color: #660000;
            color: var(--salmon-hover);
            transform: translateY(-2px);
        }

    .text-danger {
        font-size: 0.85em;
        color: var(--danger-color);
        font-weight: 500;
    }
</style>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seu Aplicativo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>
    <div class="view-content-wrapper">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="form-container">
                    <form method="post">
                        <h2>Esqueci minha senha</h2>
                        <p class="text-muted text-center mb-4">Digite seu e-mail para receber as instruções de redefinição de senha.</p>
                        <hr />

                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-group">
                            <label asp-for="Input.Email">E-mail</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn-custom">Enviar instruções</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
